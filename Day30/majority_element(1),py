# BRUTE FORCE — Nested Loops
# Time: O(n²)  Space: O(1)
def majorityElement_brute():
    arr = [1, 1, 2, 1, 3, 5, 1]
    n = len(arr)
    for i in range(n):
        count = 0
        for j in range(n):
            if arr[i] == arr[j]:
                count += 1
        if count > n // 2:
            print(f"Brute Force Result: {arr[i]}")
            return
    print("Brute Force Result: -1")
majorityElement_brute()


